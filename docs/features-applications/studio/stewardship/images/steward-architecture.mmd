        AI[AI Model]
        Guardrails[Guardrails]
    end

    %% Client Side
    subgraph Client_Side [Client / User Space]
        direction TB
        WebApp[Studio application in client browser]
    end

    %% Connections

    Steward -- Send traces --> CP
    Steward --- Studio

    Proxy -- Run inference --> AI
    Proxy -- Validate user messages --> Guardrails

    WebApp --- GW --- Studio
    Steward -- Fetch data --> DC1
    Studio -- Fetch data --> DC1
    Steward -- Call AI capabilities --> Proxy




